<div class="row">
	<div class="col-1 mx-auto">
		<nav aria-label="...">
			<ul class="pagination">
				<li class="page-item"><a href="@(GenerateUrl(Math.Max(1, CurrentPage - 1)))" class="page-link"><span class="page-text">Previous</span></a></li>
				@for (int i = 1; i <= TotalPages; i++)
				{
					var pageElement = i;
					<li class="page-item"><NavLink class="page-link" href="@(GenerateUrl(pageElement))"><span class="page-text">@pageElement</span></NavLink></li>
				}
				<li class="page-item"><a class="page-link" href="@(GenerateUrl(Math.Min(CurrentPage + 1, TotalPages)))"><span class="page-text">Next</span></a></li>
			</ul>
		</nav>
	</div>
</div>

@code {
	[EditorRequired]
	[Parameter]
	public int CurrentPage { get; set; }
	[EditorRequired]
	[Parameter]
	public int TotalPages { get; set; }
	[EditorRequired]
	[Parameter]
	public string Url { get; set; } = string.Empty;

	private string GenerateUrl(int page)
	{
		if(Url.Contains('?'))
		{
			return $"{Url}&page={page}";
		}
		else
		{
			return $"{Url}?page={page}";
		}
	}
}