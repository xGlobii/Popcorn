@using Popcorn.Shared.Dto
@using Popcorn.Shared.Enums
@inject HttpClient HttpClient

<ActionButton ButtonPressed="ManageWatchlist" ButtonText="@WatchlistButtonText" IsLoading="@WatchlistIsLoading" Icon="@WatchListIcon" Style="@WatchListStyle" />
<ActionButton ButtonPressed="ManageWatched" ButtonText="@WatchedButtonText" IsLoading="@WatchedIsLoading" Icon="@WatchedIcon" />

@code {
	public bool WatchlistIsLoading { get; set; } = false;
	public string WatchlistButtonText { get; set; } = string.Empty;
	public string WatchListIcon { get; set; } = string.Empty;
	public string WatchListStyle { get; set; } = "watchlist-btn";

	public bool WatchedIsLoading { get; set; } = false;
	public string WatchedButtonText { get; set; } = string.Empty;
	public string WatchedIcon { get; set; } = string.Empty;

	[EditorRequired]
	[Parameter]
	public int MediaId { get; set; }
	[EditorRequired]
	[Parameter]
	public string MediaType { get; set; } = string.Empty;
	[EditorRequired]
	[Parameter]
	public ActivityStatus InitialStatus { get; set; }
	[EditorRequired]
	[Parameter]
	public string Title { get; set; } = string.Empty;
	[EditorRequired]
	[Parameter]
	public string PosterPath { get; set; } = string.Empty;

	private ActivityStatus _localStatus = ActivityStatus.None;

	protected override async Task OnParametersSetAsync()
	{
		_localStatus = InitialStatus;

		SetButtonsText();
	}

	private void SetButtonsText()
	{
		WatchlistButtonText = "Add to watchlist";
		WatchListIcon = "bi-bookmark";
		WatchedButtonText = "Mark as watched";
		WatchedIcon = "bi-eye";

		if (_localStatus == ActivityStatus.ToWatch)
		{
			WatchlistButtonText = "Remove from watchlist";
			WatchListIcon = "bi-bookmark-fill";
		}
		else if (_localStatus == ActivityStatus.Watched)
		{
			WatchedButtonText = "Mark as non watched";
			WatchedIcon = "bi-check-circle";
		}
	}

	private async Task ManageWatchlist()
	{
		WatchlistIsLoading = true;
		if (_localStatus == ActivityStatus.ToWatch)
		{
			var result = await HttpClient.DeleteAsync($"api/v1/activity/{MediaType}/{MediaId}");

			if (result.IsSuccessStatusCode)
			{
				_localStatus = ActivityStatus.None;
			}
		}
		else
		{
			ActivityDto dto = new ActivityDto
			{
				MediaType = MediaType,
				Status = ActivityStatus.ToWatch,
				Title = Title,
				TmdbId = MediaId,
				PosterPath = PosterPath,
			};

			var result = await HttpClient.PutAsJsonAsync<ActivityDto>($"api/v1/activity", dto);

			if (result.IsSuccessStatusCode)
			{
				_localStatus = ActivityStatus.ToWatch;
			}
		}
		WatchlistIsLoading = false;

		SetButtonsText();
	}

	private async Task ManageWatched()
	{
		WatchedIsLoading = true;
		if (_localStatus == ActivityStatus.Watched)
		{
			var result = await HttpClient.DeleteAsync($"api/v1/activity/{MediaType}/{MediaId}");

			if (result.IsSuccessStatusCode)
			{
				_localStatus = ActivityStatus.None;
			}
		}
		else
		{
			ActivityDto dto = new ActivityDto
			{
				MediaType = MediaType,
				Status = ActivityStatus.Watched,
				Title = Title,
				TmdbId = MediaId,
				PosterPath = PosterPath
			};

			var result = await HttpClient.PutAsJsonAsync<ActivityDto>($"api/v1/activity", dto);

			if (result.IsSuccessStatusCode)
			{
				_localStatus = ActivityStatus.Watched;
			}

		}
		WatchedIsLoading = false;

		SetButtonsText();
	}
}
