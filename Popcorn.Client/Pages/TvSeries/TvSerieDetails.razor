@page "/tvs/{Id:int}"
@using Popcorn.Shared.Dto
@inject HttpClient HttpClient

@if (DetailsDto == null)
{
	<Loading />
}
else
{
	<div class="container mt-4 mb-3">
		<div class="row">
			<div class="mx-auto">
				<DetailsTemplate ImageUrl="@DetailsDto.PosterPath" Name="@DetailsDto.Name" Overview="@DetailsDto.Overview">
					<Details>
						<AdvancedDetails ReleaseDate="@DetailsDto.FirstAirDate" Status="@DetailsDto.Status" />
					</Details>
					<Homepage>
						@if (DetailsDto.HomePage != null)
						{
							<HomepageButton HomepageUrl="@DetailsDto.HomePage" />
						}
					</Homepage>
					<ListButtons>
						<MediaActionPanel MediaId="@DetailsDto.Id" MediaType="tv" />
					</ListButtons>
				</DetailsTemplate>
			</div>
		</div>
		<div class="row">
			<div class="season-collapse">
				<div class="collapse-btn py-2">
					<button type="button" class="d-flex w-100 justify-content-between seasons-btn" @onclick="() => ToggleCollapse()">
						<span class="px-3">Details</span>
						<i class="bi @Icon px-3"></i>
					</button>
				</div>
				<div class="season-details p-3" hidden="@(!IsExpanded)">
					<SerieDetails ActiveSeasonNumber="@ActiveSeason" Seasons="@DetailsDto.Seasons" SelectedSeason="HandleSeasonChange" EpisodesDetailsDto="@EpisodesDetails" />
				</div>
			</div>
		</div>
	</div>
}

@code {
	[Parameter]
	public int Id { get; set; }

	public TvSerieDetailsDto? DetailsDto { get; set; }
	public EpisodesDetailsDto? EpisodesDetails { get; set; } = null;

	public Dictionary<int, EpisodesDetailsDto> CachedEpisodes { get; set; } = new();

	public bool IsExpanded { get; set; } = false;
	public int ActiveSeason { get; set; } = 1;

	public string Icon => IsExpanded ? "bi-chevron-up" : "bi-chevron-down";

	protected async override Task OnParametersSetAsync()
	{
		ActiveSeason = 1;
		IsExpanded = false;
		CachedEpisodes.Clear();
		EpisodesDetails = null;
		DetailsDto = null;
		DetailsDto = await HttpClient.GetFromJsonAsync<TvSerieDetailsDto>($"api/v1/tvs/{Id}");
	}

	private async Task ToggleCollapse()
	{
		IsExpanded = !IsExpanded;

		if (IsExpanded)
			await GetSeasonEpisodes();
	}

	private async Task HandleSeasonChange(int season)
	{
		ActiveSeason = season;
		await GetSeasonEpisodes();
	}

	private async Task GetSeasonEpisodes()
	{
		if (CachedEpisodes.ContainsKey(ActiveSeason))
		{
			EpisodesDetails = CachedEpisodes[ActiveSeason];
		}
		else
		{
			EpisodesDetails = null;
			EpisodesDetailsDto? episodes = await HttpClient.GetFromJsonAsync<EpisodesDetailsDto>($"api/v1/tvs/{Id}/season/{ActiveSeason}");
			if (episodes != null)
			{
				CachedEpisodes.Add(ActiveSeason, episodes);
			}
			EpisodesDetails = episodes;
		}

	}
}
