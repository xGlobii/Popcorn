@page "/people/{Id:int}/filmography"
@using Popcorn.Shared.Dto
@inject HttpClient HttpClient

@if (Credits == null)
{
	<Loading />
}
else
{
	<div class="container mt-3">
		<div class="row">
			<div class="col-6">
				<h3>Movies</h3>
				@foreach (var media in Credits.Cast)
				{
					@if (media.MediaType == "movie")
					{
						<div class="card mb-3">
							<div class="row g-0">
								<div class="col-md-4">
									<img src="@media.PosterPath" class="img-fluid rounded-start" alt="...">
								</div>
								<div class="col-md-8">
									<div class="card-body">
										<h5 class="card-title">@media.Title</h5>
										<p class="card-text">@media.Overview</p>
										<a href="/@(media.MediaType)s/@media.Id" class="btn btn-action mt-auto">View</a>
									</div>
								</div>
							</div>
						</div>
					}
				}
			</div>
			<div class="col-6">
				<h3>Tv series</h3>
				@foreach (var media in Credits.Cast)
				{
					@if (media.MediaType == "tv")
					{
						<div class="card mb-3">
							<div class="row g-0">
								<div class="col-md-4">
									<img src="@media.PosterPath" class="img-fluid rounded-start" alt="...">
								</div>
								<div class="col-md-8">
									<div class="card-body">
										<h5 class="card-title">@media.Title</h5>
										<p class="card-text">@media.Overview</p>
										<a href="/@(media.MediaType)s/@media.Id" class="btn btn-action mt-auto">View</a>
									</div>
								</div>
							</div>
						</div>
					}
				}
			</div>
		</div>
	</div>
}

@code {
	[Parameter]
	public int Id { get; set; }

	public CombinedCreditsDto? Credits { get; set; }

	protected override async Task OnParametersSetAsync()
	{
		Credits = null;
		Credits = await HttpClient.GetFromJsonAsync<CombinedCreditsDto>($"api/v1/people/{Id}/filmography");
	}
}
