@page "/profile"
@using Popcorn.Shared.Dto
@attribute [Authorize]
@inject HttpClient HttpClient

@if (Dto == null)
{
	<Loading />
	<PageTitle>Loading... | Popcorn</PageTitle>
}
else
{
	<PageTitle>@Dto.Username's profile</PageTitle>
	<div class="container mt-3 mb-3">
		<div class="row mt-3">
			<div class="col-3 details">
				<h3>@Dto.Username</h3>
				<div>
					<ul class="list-group">
						<li class="list-group-item d-flex justify-content-between align-items-center">
							<a href="/library?page=1&status=watched" class="text-decoration-none text-reset stretched-link">
								Watched
							</a>
							<span class="badge badge-bg rounded-pill">@Dto.WatchedCount</span>
						</li>
						<li class="list-group-item d-flex justify-content-between align-items-center">
							<a href="/library?page=1&status=to_watch" class="text-decoration-none text-reset stretched-link">
								To watch
							</a>
							<span class="badge badge-bg rounded-pill">@Dto.ToWatchCount</span>
						</li>
						<li class="list-group-item d-flex justify-content-between align-items-center">
							<a href="/library?page=1&media-type=movie" class="text-decoration-none text-reset stretched-link">
								Movies
							</a>
							<span class="badge badge-bg rounded-pill">@Dto.MoviesCount</span>
						</li>
						<li class="list-group-item d-flex justify-content-between align-items-center">
							<a href="/library?page=1&media-type=tv" class="text-decoration-none text-reset stretched-link">
								Tv series
							</a>
							<span class="badge badge-bg rounded-pill">@Dto.TvSeriesCount</span>
						</li>
					</ul>
				</div>
			</div>
			<div class="col-9">
				<div class="row movies">
					<div class="col">
						<div class="row mt-2">
							<h5>Last Movie Activity</h5>
						</div>
						<div class="row justify-content-center mb-2">
							@foreach (var movie in Dto.Movies)
							{
								<div class="col-auto">
									<a href="@GenerateUrl(movie.MediaType, movie.TmdbId)" class="text-decoration-none">
										<div class="card card-latest h-100" style="max-width: 12rem;">
											<img src="@movie.PosterPath" class="card-img-top" alt="...">
											<div class="card-body">
												<p class="card-text">@movie.Title</p>
												<div class="d-flex justify-content-between">
													<span class="card-text small">@movie.Status</span>
													<span class="card-text small">@movie.AddedAt</span>
												</div>
											</div>
										</div>
									</a>
								</div>
							}
						</div>
					</div>
				</div>
				<div class="row series">
					<div class="col">
						<div class="row mt-2">
							<h5>Last Tv Series Activity</h5>
						</div>
						<div class="row justify-content-center mb-2">
							@foreach (var serie in Dto.TvSeries)
							{
								<div class="col-auto">
									<a href="@GenerateUrl(serie.MediaType, serie.TmdbId)" class="text-decoration-none">
										<div class="card card-latest h-100" style="max-width: 12rem;">
											<img src="@serie.PosterPath" class="card-img-top" alt="...">
											<div class="card-body">
												<p class="card-text">@serie.Title</p>
												<div class="d-flex justify-content-between">
													<span class="card-text small">@serie.Status</span>
													<span class="card-text small">@serie.AddedAt</span>
												</div>
											</div>
										</div>
									</a>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

@code {
	public ProfileDto? Dto { get; set; }

	protected override async Task OnInitializedAsync()
	{
		Dto = await HttpClient.GetFromJsonAsync<ProfileDto>("api/v1/profile");
	}

	private string GenerateUrl(string mediaType, int id)
	{
		return $"/{mediaType}s/{id}";
	}
}
