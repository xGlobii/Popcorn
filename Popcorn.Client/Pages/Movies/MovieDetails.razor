@page "/movies/{Id:int}"
@using Popcorn.Shared.Dto
@inject HttpClient HttpClient

@if (DetailsDto == null)
{
	<Loading />
	<PageTitle>Loading... | Popcorn</PageTitle>
}
else
{
	<PageTitle>@DetailsDto.Title | Popcorn</PageTitle>
	<div class="container mt-4">
		<div class="row">
			<div class="mx-auto">
				<DetailsTemplate ImageUrl="@DetailsDto.PosterPath" Name="@DetailsDto.Title" Overview="@DetailsDto.Overview">
					<Details>
						<AdvancedDetails Status="@DetailsDto.Status" ReleaseDate="@DetailsDto.ReleaseDate"/>
					</Details>
					<Homepage>
						@if (DetailsDto.HomePage != null)
						{
							<HomepageButton HomepageUrl="@DetailsDto.HomePage" />
						}
					</Homepage>
					<ListButtons>
						<MediaActionPanel MediaId="@DetailsDto.Id" MediaType="movie" Title="@DetailsDto.Title" InitialStatus="@DetailsDto.MediaStatus" PosterPath="@DetailsDto.PosterPath"/>
					</ListButtons>
				</DetailsTemplate>
			</div>
			<div class="row">
				<ActorsSlider Cast="DetailsDto.Cast"/>
			</div>
		</div>
	</div>
}

@code {
	[Parameter]
	public int Id { get; set; }

	public MovieDetailsDto? DetailsDto { get; set; }

	protected async override Task OnParametersSetAsync()
	{
		DetailsDto = null;
		DetailsDto = await HttpClient.GetFromJsonAsync<MovieDetailsDto>($"api/v1/movies/{Id}");
	}
}
