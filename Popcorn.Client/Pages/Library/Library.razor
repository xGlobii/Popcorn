@page "/library"
@using Popcorn.Shared.Dto
@using System.Timers;
@attribute [Authorize]
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Library - Popcorn</PageTitle>

@if (Dto == null)
{
	<Loading />
}
else
{
	<div class="container">
		<div class="row mt-4 mb-3">
			<div class="col-8 mx-auto">
				<form class="d-flex" role="search">
					<input class="form-control me-2" type="search" placeholder="Search" value="@Query" aria-label="Search" @oninput="Input" />
				</form>

				<div class="mt-1">
					<label for="media-type-select">Media type:</label>
					<select id="media-type-select" @onchange="FilterMediaType" value="@MediaType">
						<option value="">All</option>
						<option value="movie">Movie</option>
						<option value="tv">Tv Serie</option>
					</select>

					<label for="status-select">Status:</label>
					<select id="status-select" @onchange="FilterStatus" value="@Status">
						<option value="">All</option>
						<option value="watched">Watched</option>
						<option value="to_watch">To watch</option>
					</select>
				</div>

			</div>
		</div>
		<div class="row">
			<div class="col-8 mx-auto mt-3 library-container">
				@if (!Dto.Items.Any())
				{
					<h2>Nothing to display here</h2>
				}
				else
				{
					<div class="card">
						<ul class="list-group list-group-flush">
							@foreach (var item in Dto.Items)
							{
								<li class="list-group-item d-flex justify-content-between">
									<a href="/@(item.MediaType)s/@item.TmdbId" class="text-decoration-none text-reset align-self-center stretched-link">
										<span class="align-self-center">@item.Title</span>
									</a>
									<div class="position-relative z-3">
										<span class="badge rounded-pill media-type-badge mx-2">@item.MediaType.ToUpper()</span>
										<span class="mx-2">@item.Status</span>
										<div class="btn mx-3 list-delete-btn" @onclick="@(() => Delete(item.TmdbId, item.MediaType))">[ Delete ]</div>
									</div>
								</li>
							}
						</ul>
					</div>
				}
			</div>
		</div>
		@if (Dto.Items.Any())
		{
			<Pagination CurrentPage="Page" TotalPages="Dto.TotalPages" Url="@BuildUrl()" />
		}
	</div>
}

@code {
	[SupplyParameterFromQuery]
	[Parameter]
	public int Page { get; set; }
	[SupplyParameterFromQuery]
	[Parameter]
	public string Query { get; set; } = string.Empty;
	[SupplyParameterFromQuery(Name = "media-type")]
	[Parameter]
	public string MediaType { get; set; } = string.Empty;
	[SupplyParameterFromQuery]
	[Parameter]
	public string Status { get; set; } = string.Empty;

	public LibraryDto? Dto { get; set; }

	private Timer _timer = new Timer(500);

	protected override async Task OnInitializedAsync()
	{
		_timer.AutoReset = false;
		_timer.Elapsed += FilterList;
	}

	protected override async Task OnParametersSetAsync()
	{
		Dto = null;
		Dto = await HttpClient.GetFromJsonAsync<LibraryDto>($"api/v1/library?page={Page}&query={Query}&mediatype={MediaType}&status={Status}");
	}

	private async Task Delete(int tmdbId, string mediaType)
	{
		var result = await HttpClient.DeleteAsync($"api/v1/activity/{mediaType}/{tmdbId}");
		if (result.IsSuccessStatusCode)
		{
			List<MediaItemDto>? newList = new();
			if (Dto != null)
			{
				foreach (var item in Dto.Items.Where(d => d.TmdbId != tmdbId || d.MediaType != mediaType))
				{
					newList.Add(item);
				}
				Dto.Items = newList;
			}
		}
	}

	private void Input(ChangeEventArgs eventArgs)
	{
		if (eventArgs.Value is string query)
		{
			_timer.Stop();
			Query = query;
			_timer.Start();
		}
	}

	private async void FilterList(Object? source, ElapsedEventArgs e)
	{
		await InvokeAsync(Redirect);
	}

	private void Redirect()
	{
		string url = BuildUrl();
		if(url.Contains('?'))
			NavigationManager.NavigateTo($"{url}&page=1", replace: true);
		else
			NavigationManager.NavigateTo("/library?page=1", replace: true);
	}

	private string BuildUrl()
	{
		List<string> parameters = new();

		if (!string.IsNullOrEmpty(Query))
			parameters.Add($"query={Query}");
		if (!string.IsNullOrEmpty(MediaType))
			parameters.Add($"media-type={MediaType}");
		if (!string.IsNullOrEmpty(Status))
			parameters.Add($"status={Status}");

		string urlParams = String.Join("&", parameters);
		string baseUrl = "/library";

		if (string.IsNullOrEmpty(urlParams))
			return baseUrl;

		return $"{baseUrl}?{urlParams}";
	}

	public void Dispose()
	{
		_timer.Dispose();
	}

	private void FilterMediaType(ChangeEventArgs e)
	{
		if(e.Value is string mediaType)
		{
			MediaType = mediaType;
			Redirect();
		}
	}

	private void FilterStatus(ChangeEventArgs e)
	{
		if(e.Value is string status)
		{
			Status = status;
			Redirect();
		}
	}
}
