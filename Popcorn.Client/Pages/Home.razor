@page "/"
@using Popcorn.Shared.Dto
@inject HttpClient httpClient

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

@code {

	public ResponseDto? Response;

	protected override async Task OnInitializedAsync()
	{
		Response = await httpClient.GetFromJsonAsync<ResponseDto>($"api/v1/search/multi?title={Uri.EscapeDataString("harry potter")}");
	}
}

@if(Response == null)
{
	<h2>Ładowanie...</h2>
}
else
{
	foreach(var item in Response.Results)
	{
		<h2>
			@item.Id | <img src="@item.ImagePath"/> | @item.MediaType | @item.Name | @item.Overview
		</h2>
	}
}




Welcome to your new app.
