@page "/search"
@using Popcorn.Shared.Dto
@inject HttpClient httpClient

@if (Response == null)
{
	<Loading />
}
else if(Query == null)
{
	<h2>Enter the title of the movie or TV show, or the name of the person you want to find</h2>
}
else
{
	<div class="container mt-4">
		<div class="row">
			<div class="col-9 mx-auto">
				@foreach (var item in Response.Results)
				{
					<ListItem Id="@item.Id" ImagePath="@item.ImagePath" MediaType="@item.MediaType" Overview="@item.Overview" Name="@item.Name" Url="@item.Url" />
				}
			</div>
		</div>
	</div>
	<Pagination CurrentPage="@Response.Page" TotalPages="@Response.TotalPages" Url="@GenerateUrl(MediaType, Query)"/>
}

@code {
	[SupplyParameterFromQuery]
	public string? Query { get; set; }
	[SupplyParameterFromQuery]
	public int Page { get; set; } = 1;
	[SupplyParameterFromQuery(Name = "media-type")]
	public string MediaType { get; set; } = "multi";
	public ResponseDto? Response { get; set; }

	protected override async Task OnParametersSetAsync()
	{
		Response = null;
		if (Query != null)
			Response = await httpClient.GetFromJsonAsync<ResponseDto>($"api/v1/search/{MediaType}?query={Uri.EscapeDataString(Query)}&page={Page}");
	}

	private string GenerateUrl(string mediaType, string query)
	{
		return $"/search?query={Uri.EscapeDataString(query)}&media-type={mediaType}";
	}
}
